# =============================================================================
# MTMS Environment Variables — copy to .env and fill with real values
# =============================================================================
# DO NOT commit .env — this file is a placeholder template only.

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
DB_HOST=192.168.x.x
DB_PORT=5432
DB_NAME=gresik
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# DATABASE_URL is built from DB_HOST/PORT/NAME/USER/PASSWORD (URL-encoded password)
# Example: postgresql://user:pass%40word@host:5432/dbname
DATABASE_URL=postgresql://your_db_user:your_password@192.168.x.x:5432/gresik

# ── OAuth (Google) ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── MFA Encryption ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
MFA_ENCRYPTION_SECRET=your_32_byte_base64_secret_here

# ── Cache Encryption ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
CACHE_ENCRYPTION_KEY=your_32_byte_base64_secret_here

# ── Cloudflare Turnstile (bot protection) ──────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_site_key
TURNSTILE_SECRET_KEY=your_secret_key

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://192.168.x.x:6379
REDIS_PASS=your_redis_password

# ── Better Auth ───────────────────────────────────────────────────────────────
# Base URL of the app (e.g. http://localhost:3000 for dev)
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_32_byte_base64_secret_here

# ── Lensa Scraper (Telkom Akses inventory portal) ─────────────────────────────
LENSA_URL=https://lensa-inventory.telkomakses.co.id/
# Cutoff month for scraping historical data (format: YYYY-MM)
CUTOFF_MONTH=2026-01

# ── Encryption Key (for Lensa credentials) ────────────────────────────────────
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your_32_byte_base64_secret_here
